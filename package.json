{
  "name": "recallgen",
  "version": "0.1.1",
  "type": "module",
  "description": "AI-powered quiz generation and spaced review plugin for SiYuan (https://b3log.org/siyuan)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solathis/siyuan-recallgen.git"
  },
  "homepage": "https://github.com/Solathis/siyuan-recallgen",
  "bugs": {
    "url": "https://github.com/Solathis/siyuan-recallgen/issues"
  },
  "author": "Solathis",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "quiz",
    "spaced-repetition",
    "ai"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite --config vite.preview.config.ts",
    "preview:build": "vite build --config vite.preview.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.52.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "jsonrepair": "^3.15.0",
    "katex": "^0.18.1",
    "layerchart": "^2.5.2",
    "marked": "^18.0.9",
    "p-limit": "^7.3.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "siyuan": "^1.2.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^4.1.11"
  }
}
