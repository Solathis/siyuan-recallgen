{
  "name": "recallgen",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered quiz generation and spaced review plugin for SiYuan (https://b3log.org/siyuan)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solathis/siyuan-recallgen.git"
  },
  "homepage": "https://github.com/Solathis/siyuan-recallgen",
  "bugs": {
    "url": "https://github.com/Solathis/siyuan-recallgen/issues"
  },
  "author": "Solathis",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "quiz",
    "spaced-repetition",
    "ai"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run format:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "jsonrepair": "^3.15.0",
    "katex": "^0.18.1",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/node": "^20.3.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.5.2",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.2.3",
    "svelte": "^4.2.20",
    "svelte-check": "^4.7.6",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^3.2.7"
  }
}
